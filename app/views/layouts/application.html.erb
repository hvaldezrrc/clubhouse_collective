<!DOCTYPE html>
<html>
  <head>
    <title>Clubhouse Collective</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <style>
      body {
        font-family: Arial, sans-serif;
        margin: 0;
        padding: 20px;
      }
      .notice, .alert {
        padding: 10px;
        margin-bottom: 15px;
      }
      .notice { background-color: #d4edda; }
      .alert { background-color: #f8d7da; }
    </style>

    <%# <%= javascript_importmap_tags %>
  </head>

  <body>
    <p class="notice"><%= notice %></p>
    <p class="alert"><%= alert %></p>

    <%= yield %>
  </body>
</html>