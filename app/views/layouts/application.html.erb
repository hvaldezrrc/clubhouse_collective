<!DOCTYPE html>
<html>
  <head>
    <title>Clubhouse Collective</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <style>
      body {
        font-family: Arial, sans-serif;
        margin: 0;
        padding: 0;
        color: #333;
        line-height: 1.6;
      }

      .notice, .alert {
        padding: 10px;
        margin-bottom: 15px;
      }
      .notice { background-color: #d4edda; }
      .alert { background-color: #f8d7da; }

      /* Header styles */
      header {
        background-color: #2c3e50;
        color: #fff;
        padding: 15px 0;
      }

      .header-container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 20px;
        display: flex;
        justify-content: space-between;
        align-items: center;
      }

      .logo a {
        color: #fff;
        text-decoration: none;
        font-size: 1.5rem;
        font-weight: bold;
      }

      nav ul {
        list-style: none;
        display: flex;
        margin: 0;
        padding: 0;
      }

      nav ul li {
        margin-left: 20px;
      }

      nav ul li a {
        color: #fff;
        text-decoration: none;
        padding: 5px 0;
        transition: color 0.3s;
      }

      nav ul li a:hover {
        color: #3498db;
      }

      /* Footer styles */
      footer {
        background-color: #34495e;
        color: #ecf0f1;
        padding: 30px 0;
        margin-top: 50px;
      }

      .footer-container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 20px;
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 30px;
      }

      .footer-section h3 {
        color: #fff;
        margin-bottom: 15px;
        font-size: 1.2rem;
      }

      .footer-section p {
        margin: 5px 0;
      }

      .footer-section ul {
        list-style: none;
        padding: 0;
      }

      .footer-section ul li {
        margin-bottom: 8px;
      }

      .footer-section a {
        color: #bdc3c7;
        text-decoration: none;
        transition: color 0.3s;
      }

      .footer-section a:hover {
        color: #3498db;
      }

      .copyright {
        margin-top: 20px;
        text-align: center;
        color: #95a5a6;
        font-size: 0.9rem;
        padding-top: 20px;
        border-top: 1px solid #4a6377;
      }
    </style>

  </head>

  <body>
    <header>
      <div class="header-container">
        <div class="logo">
          <%= link_to "Clubhouse Collective", root_path %>
        </div>
        <nav>
          <ul>
            <li><%= link_to "Home", root_path %></li>
            <li><%= link_to "Products", products_path %></li>
            <li><%= link_to "About", "/about" %></li>
            <li><%= link_to "Contact", "/contact" %></li>
          </ul>
        </nav>
      </div>
    </header>

    <% if notice %>
      <div class="notice"><%= notice %></div>
    <% end %>
    <% if alert %>
      <div class="alert"><%= alert %></div>
    <% end %>

    <%= yield %>

    <footer>
      <div class="footer-container">
        <div class="footer-section">
          <h3>Clubhouse Collective</h3>
          <p>Premium golf gear and streetwear for the modern golfer.</p>
        </div>
        <div class="footer-section">
          <h3>Quick Links</h3>
          <ul>
            <li><%= link_to "Home", root_path %></li>
            <li><%= link_to "Products", products_path %></li>
            <li><%= link_to "About", "/about" %></li>
            <li><%= link_to "Contact", "/contact" %></li>
          </ul>
        </div>
        <div class="footer-section">
          <h3>Contact Us</h3>
          <p>Email: info@clubhousecollective.com</p>
          <p>Phone: (204) 555-1234</p>
        </div>
      </div>
      <div class="copyright">
        &copy; <%= Date.today.year %> Clubhouse Collective. All Rights Reserved.
      </div>
    </footer>
  </body>
</html>