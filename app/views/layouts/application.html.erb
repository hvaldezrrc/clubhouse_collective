<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <title>Clubhouse Collective</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%# <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%# <%= javascript_include_tag "application", "data-turbo-track": "reload", defer: true %>

    <style>
      html, body {
        font-family: system-ui, sans-serif;
        margin: 0;
        padding: 0;
        color: #333;
        background: #fff;
        line-height: 1.6;
        flex-direction: column;
      }

      header {
        background: #1f2937;
        color: #fff;
        padding: 1rem 0;
      }
      .header-container {
        max-width: 1200px;
        margin: auto;
        padding: 0 1rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
      }
      .logo a {
        font-size: 1.5rem;
        font-weight: bold;
        color: inherit;
        text-decoration: none;
      }
      nav ul {
        display: flex;
        list-style: none;
        margin: 0;
        padding: 0;
      }
      nav li + li {
        margin-left: 1rem;
      }
      nav a {
        color: inherit;
        text-decoration: none;
      }
      nav a:hover {
        color: #3b82f6;
      }

      .notice, .alert {
        margin: 1rem;
        padding: 0.75rem 1rem;
        border-radius: 0.375rem;
      }
      .notice {
        background: #d1fae5;
      }
      .alert {
        background: #fee2e2;
      }

      footer {
        background: #1f2937;
        color: #d1d5db;
        padding: 2rem 0;
      }
      .footer-container {
        max-width: 1200px;
        margin: auto;
        padding: 0 1rem;
        display: grid;
        gap: 1.5rem;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      }
      .footer-section h3 {
        font-size: 1.125rem;
        margin-bottom: 1rem;
      }
      .footer-section a {
        color: #9ca3af;
        text-decoration: none;
      }
      .footer-section a:hover {
        color: #3b82f6;
      }
      .copyright {
        text-align: center;
        margin-top: 2rem;
        font-size: 0.875rem;
        color: #6b7280;
      }

      .breadcrumb {
        font-size: 0.875rem;
        color: #6b7280;
        margin: 1rem 0;
      }
      .breadcrumb a {
        color: #3b82f6;
        text-decoration: none;
      }
      .breadcrumb a:hover {
        text-decoration: underline;
      }
      .product-container {
        display: grid;
        gap: 2rem;
        grid-template-columns: 1fr 1fr;
        margin-bottom: 3rem;
      }
      .main-image {
        width: 100%;
        height: 400px;
        background: #f9fafb;
        border-radius: 0.5rem;
        overflow: hidden;
      }
      .main-image img {
        width: 100%;
        height: 100%;
        object-fit: contain;
      }
      .thumbnail-images {
        display: flex;
        gap: 0.5rem;
        overflow-x: auto;
        margin-top: 1rem;
      }
      .thumbnail {
        width: 80px;
        height: 80px;
        object-fit: cover;
        border-radius: 0.25rem;
        cursor: pointer;
        border: 2px solid transparent;
      }
      .thumbnail:hover {
        border-color: #3b82f6;
      }
      .product-info h1 {
        font-size: 1.875rem;
        margin-bottom: 1rem;
        color: #111827;
      }
      .product-description h3 {
        font-size: 1.125rem;
        margin-bottom: 0.5rem;
      }
      .stock-info {
        margin: 1rem 0;
      }
      .in-stock {
        color: #10b981;
        font-weight: 600;
      }
      .out-of-stock {
        color: #ef4444;
        font-weight: 600;
      }
      .add-to-cart-btn {
        background: #3b82f6;
        color: white;
        border: none;
        padding: 0.75rem 1.5rem;
        border-radius: 0.375rem;
        font-weight: bold;
        cursor: pointer;
      }
      .add-to-cart-btn:hover {
        background: #2563eb;
      }

      .related-products {
        margin-top: 3rem;
      }
      .related-products h2 {
        font-size: 1.5rem;
        margin-bottom: 1rem;
      }
      .related-products-grid {
        display: grid;
        gap: 1.5rem;
        grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
      }
      .related-product-card {
        border: 1px solid #e5e7eb;
        border-radius: 0.375rem;
        overflow: hidden;
        transition: transform 0.2s ease;
      }
      .related-product-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.05);
      }
      .related-product-card h3 {
        padding: 0.75rem;
        font-size: 0.875rem;
        color: #111827;
      }

      .category-sidebar h3 {
        margin-top: 2rem;
      }
      .category-sidebar ul {
        list-style: none;
        padding: 0;
      }
      .category-sidebar li {
        margin-bottom: 0.75rem;
      }
      .category-sidebar a {
        color: #3b82f6;
        text-decoration: none;
      }
      .category-sidebar a:hover {
        color: #2563eb;
      }

      .cart-page {
        margin-top: 2rem;
      }
      .cart-page h1 {
        margin-bottom: 2rem;
      }
      .cart-table {
        width: 100%;
        border-collapse: collapse;
        margin-bottom: 2rem;
      }
      .cart-table th, .cart-table td {
        padding: 1rem;
        border-bottom: 1px solid #e5e7eb;
      }
      .cart-thumbnail {
        width: 80px;
        height: 80px;
        object-fit: contain;
        background: #f9fafb;
      }
      .quantity-input {
        width: 60px;
        padding: 0.5rem;
        border: 1px solid #e5e7eb;
        border-radius: 0.375rem;
        text-align: center;
      }
      .update-btn, .remove-btn, .empty-cart-btn, .continue-shopping-btn, .checkout-btn {
        padding: 0.5rem 1rem;
        border-radius: 0.375rem;
        font-size: 0.875rem;
        font-weight: 500;
        border: none;
        cursor: pointer;
      }
      .update-btn {
        background: #9ca3af;
        color: white;
      }
      .update-btn:hover {
        background: #6b7280;
      }
      .remove-btn, .empty-cart-btn {
        background: #ef4444;
        color: white;
      }
      .remove-btn:hover, .empty-cart-btn:hover {
        background: #dc2626;
      }
      .continue-shopping-btn {
        background: #6b7280;
        color: white;
      }
      .continue-shopping-btn:hover {
        background: #4b5563;
      }
      .checkout-btn {
        background: #10b981;
        color: white;
      }
      .checkout-btn:hover {
        background: #059669;
      }

      .checkout-page {
        margin-top: 30px;
        max-width: 800px;
      }

      .checkout-page h1 {
        margin-bottom: 30px;
        color: #2c3e50;
      }

      .checkout-progress {
        display: flex;
        margin-bottom: 30px;
        border-bottom: 1px solid #e1e1e1;
        padding-bottom: 20px;
      }

      .checkout-progress .step {
        flex: 1;
        text-align: center;
        padding: 10px;
        color: #95a5a6;
        position: relative;
      }

      .checkout-progress .step::after {
        content: "";
        position: absolute;
        width: 20px;
        height: 20px;
        background-color: #f8f9fa;
        border: 1px solid #e1e1e1;
        border-radius: 50%;
        bottom: -10px;
        left: calc(50% - 10px);
      }

      .checkout-progress .step.active {
        color: #3498db;
        font-weight: bold;
      }

      .checkout-progress .step.active::after {
        background-color: #3498db;
        border-color: #3498db;
      }

      .checkout-progress .step.completed {
        color: #27ae60;
      }

      .checkout-progress .step.completed::after {
        background-color: #27ae60;
        border-color: #27ae60;
      }

      .checkout-form {
        background-color: #f8f9fa;
        padding: 20px;
        border-radius: 5px;
        margin-bottom: 30px;
      }

      .form-group {
        margin-bottom: 20px;
      }

      .form-group label {
        display: block;
        margin-bottom: 8px;
        font-weight: bold;
        color: #2c3e50;
      }

      .form-control {
        width: 100%;
        padding: 10px;
        border: 1px solid #e1e1e1;
        border-radius: 4px;
        font-size: 1rem;
      }

      .form-actions {
        display: flex;
        justify-content: space-between;
        margin-top: 30px;
      }

      .back-btn {
        background-color: #7f8c8d;
        color: white;
        border: none;
        padding: 10px 20px;
        border-radius: 4px;
        text-decoration: none;
        font-size: 1rem;
      }

      .back-btn:hover {
        background-color: #95a5a6;
      }

      .continue-btn, .place-order-btn {
        background-color: #3498db;
        color: white;
        border: none;
        padding: 10px 20px;
        border-radius: 4px;
        font-size: 1rem;
        cursor: pointer;
      }

      .continue-btn:hover {
        background-color: #2980b9;
      }

      .place-order-btn {
        background-color: #27ae60;
      }

      .place-order-btn:hover {
        background-color: #2ecc71;
      }

      .order-summary {
        background-color: #f8f9fa;
        padding: 20px;
        border-radius: 5px;
        margin-bottom: 30px;
      }

      .order-summary h2 {
        margin-top: 0;
        margin-bottom: 20px;
        color: #2c3e50;
        font-size: 1.5rem;
      }

      .summary-table {
        width: 100%;
      }

      .summary-table td {
        padding: 8px 0;
        border-bottom: 1px solid #e1e1e1;
      }

      .summary-table .price {
        text-align: right;
        font-weight: bold;
      }

      .summary-table .total {
        font-size: 1.1rem;
        font-weight: bold;
        color: #2c3e50;
      }

      .payment-form {
        background-color: #f8f9fa;
        padding: 20px;
        border-radius: 5px;
        margin-bottom: 30px;
      }

      .demo-notice {
        padding: 15px;
        background-color: #f39c12;
        color: white;
        border-radius: 4px;
        margin-bottom: 20px;
      }

      .order-details {
        margin-bottom: 30px;
      }

      .address-details, .payment-details {
        background-color: #f8f9fa;
        padding: 20px;
        border-radius: 5px;
        margin-bottom: 20px;
      }

      .address-details h2, .payment-details h2 {
        margin-top: 0;
        margin-bottom: 15px;
        color: #2c3e50;
        font-size: 1.3rem;
      }

      .error-messages {
        background-color: #f8d7da;
        color: #721c24;
        padding: 15px;
        border-radius: 4px;
        margin-bottom: 20px;
      }

      .error-messages ul {
        margin: 0;
        padding-left: 20px;
      }

      .order-total {
        font-size: 1.2rem;
        font-weight: bold;
      }

      .total-amount {
        color: #27ae60;
        font-size: 1.2rem;
        font-weight: bold;
      }

      .dashboard-page {
        margin-top: 30px;
      }

      .dashboard-page h1 {
        margin-bottom: 30px;
        color: #2c3e50;
      }

      .dashboard-welcome {
        background-color: #f8f9fa;
        padding: 20px;
        border-radius: 5px;
        margin-bottom: 30px;
      }

      .dashboard-section {
        margin-bottom: 40px;
      }

      .dashboard-section h2 {
        margin-bottom: 20px;
        color: #2c3e50;
        font-size: 1.5rem;
      }

      .orders-table {
        width: 100%;
        border-collapse: collapse;
        margin-bottom: 20px;
      }

      .orders-table th {
        background-color: #f8f9fa;
        padding: 12px;
        text-align: left;
        color: #2c3e50;
        font-weight: 600;
      }

      .orders-table td {
        padding: 12px;
        border-bottom: 1px solid #e1e1e1;
      }

      .status {
        display: inline-block;
        padding: 5px 10px;
        border-radius: 20px;
        font-size: 0.8rem;
        font-weight: bold;
        text-transform: uppercase;
      }

      .status.pending {
        background-color: #f1c40f;
        color: #7f8c8d;
      }

      .status.processing {
        background-color: #3498db;
        color: white;
      }

      .status.shipped {
        background-color: #9b59b6;
        color: white;
      }

      .status.delivered {
        background-color: #27ae60;
        color: white;
      }

      .status.cancelled {
        background-color: #e74c3c;
        color: white;
      }

      .view-btn {
        background-color: #3498db;
        color: white;
        border: none;
        padding: 5px 10px;
        border-radius: 4px;
        text-decoration: none;
        font-size: 0.9rem;
      }

      .view-btn:hover {
        background-color: #2980b9;
      }

      .view-all {
        text-align: right;
        margin-top: 20px;
      }

      .view-all-btn {
        display: inline-block;
        background-color: #7f8c8d;
        color: white;
        border: none;
        padding: 8px 15px;
        border-radius: 4px;
        text-decoration: none;
        font-size: 0.9rem;
      }

      .view-all-btn:hover {
        background-color: #95a5a6;
      }

      .no-orders {
        background-color: #f8f9fa;
        padding: 30px;
        text-align: center;
        border-radius: 5px;
        color: #7f8c8d;
        font-size: 1.1rem;
      }

      .shop-btn {
        display: block;
        width: 200px;
        margin: 20px auto;
        background-color: #3498db;
        color: white;
        border: none;
        padding: 10px 0;
        border-radius: 4px;
        text-decoration: none;
        text-align: center;
        font-size: 1rem;
      }

      .shop-btn:hover {
        background-color: #2980b9;
      }

      .order-meta {
        background-color: #f8f9fa;
        padding: 15px;
        border-radius: 5px;
        margin-bottom: 30px;
      }

      .order-details {
        display: grid;
        grid-template-columns: 1fr 2fr;
        gap: 30px;
        margin-bottom: 30px;
      }

      .shipping-address, .order-items {
        background-color: #f8f9fa;
        padding: 20px;
        border-radius: 5px;
      }

      .shipping-address h2, .order-items h2 {
        margin-top: 0;
        margin-bottom: 15px;
        color: #2c3e50;
        font-size: 1.3rem;
      }

      .order-items-table {
        width: 100%;
      }

      .product-category {
        color: #7f8c8d;
        font-size: 0.9rem;
        margin: 0;
      }

      @media (max-width: 768px) {
        .header-container, .footer-container {
          flex-direction: column;
          text-align: center;
        }
        nav ul {
          flex-direction: column;
          gap: 0.75rem;
          margin-top: 1rem;
        }
        .product-container {
          grid-template-columns: 1fr;
        }
        .related-products-grid {
          grid-template-columns: 1fr 1fr;
        }
      }
    </style>
  </head>

  <body>
  <header>
    <div class="header-container">
      <div class="logo">
        <%= link_to "Clubhouse Collective", root_path %>
      </div>
      <nav>
        <ul>
          <li><%= link_to "Home", root_path %></li>
          <li><%= link_to "Products", products_path %></li>
          <li><%= link_to "About", "/about" %></li>
          <li><%= link_to "Contact", "/contact" %></li>
          <li class="cart-link">
            <%= link_to cart_path do %>
              Cart
              <% if session[:cart].present? && !session[:cart].empty? %>
                <span class="cart-count"><%= session[:cart].sum { |item| item[:quantity].to_i } %></span>
              <% end %>
            <% end %>
          </li>
        </ul>
      </nav>
    </div>
  </header>

    <% if notice %>
      <div class="notice"><%= notice %></div>
    <% end %>
    <% if alert %>
      <div class="alert"><%= alert %></div>
    <% end %>

    <main>
      <%= yield %>
    </main>

    <footer>
      <div class="footer-container">
        <div class="footer-section">
          <h3>Clubhouse Collective</h3>
          <p>Premium golf gear and streetwear for the modern golfer.</p>
        </div>

        <nav class="footer-section">
          <h3>Quick Links</h3>
          <ul>
            <li><%= link_to "Home", root_path %></li>
            <li><%= link_to "Products", products_path %></li>
            <li><%= link_to "About", "/about" %></li>
            <li><%= link_to "Contact", "/contact" %></li>
            <li class="cart-link">
                <%= link_to cart_path do %>
                  Cart
                  <% if session[:cart].present? && !session[:cart].empty? %>
                    <span class="cart-count"><%= session[:cart].sum { |item| item[:quantity].to_i } %></span>
                  <% end %>
                <% end %>
            </li>
          </ul>
        </nav>

        <div class="footer-section">
          <h3>Contact Us</h3>
          <p>Email: info@clubhousecollective.com</p>
          <p>Phone: (204) 555-1234</p>
        </div>
      </div>

      <div class="copyright">
        &copy; <%= Date.today.year %> Clubhouse Collective. All Rights Reserved.
      </div>
    </footer>

  </body>
</html>