<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <title>Clubhouse Collective</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%# <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%# <%= javascript_include_tag "application", "data-turbo-track": "reload", defer: true %>

    <style>
      body {
        font-family: Arial, sans-serif;
        margin: 0;
        padding: 0;
        color: #333;
        line-height: 1.6;
        background-color: #fff;
      }

      .notice, .alert {
        padding: 10px;
        margin: 15px 20px;
        border-radius: 5px;
      }
      .notice { background-color: #d4edda; }
      .alert { background-color: #f8d7da; }

      header {
        background-color: #2c3e50;
        color: #fff;
        padding: 15px 0;
      }
      .header-container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 20px;
        display: flex;
        justify-content: space-between;
        align-items: center;
      }
      .logo a {
        color: #fff;
        text-decoration: none;
        font-size: 1.5rem;
        font-weight: bold;
      }
      nav ul {
        list-style: none;
        display: flex;
        margin: 0;
        padding: 0;
      }
      nav ul li {
        margin-left: 20px;
      }
      nav ul li a {
        color: #fff;
        text-decoration: none;
        transition: color 0.3s;
      }
      nav ul li a:hover {
        color: #3498db;
      }

      footer {
        background-color: #34495e;
        color: #ecf0f1;
        padding: 30px 0;
        margin-top: 50px;
      }
      .footer-container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 20px;
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 30px;
      }
      .footer-section h3 {
        color: #fff;
        margin-bottom: 15px;
        font-size: 1.2rem;
      }
      .footer-section p, .footer-section ul {
        margin: 0;
        padding: 0;
        list-style: none;
      }
      .footer-section ul li {
        margin-bottom: 8px;
      }
      .footer-section a {
        color: #bdc3c7;
        text-decoration: none;
        transition: color 0.3s;
      }
      .footer-section a:hover {
        color: #3498db;
      }
      .copyright {
        text-align: center;
        color: #95a5a6;
        font-size: 0.9rem;
        padding-top: 20px;
        border-top: 1px solid #4a6377;
        margin-top: 20px;
      }
      .product-detail {
        margin-top: 30px;
      }

      .breadcrumb {
        margin-bottom: 20px;
        color: #7f8c8d;
        font-size: 0.9rem;
      }

      .breadcrumb a {
        color: #3498db;
        text-decoration: none;
      }

      .breadcrumb a:hover {
        text-decoration: underline;
      }

      .product-container {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 30px;
        margin-bottom: 50px;
      }

      .main-image {
        width: 100%;
        height: 400px;
        overflow: hidden;
        border-radius: 5px;
        margin-bottom: 10px;
      }

      .main-image img {
        width: 100%;
        height: 100%;
        object-fit: contain;
        background-color: #f8f9fa;
      }

      .thumbnail-images {
        display: flex;
        gap: 10px;
        overflow-x: auto;
      }

      .thumbnail {
        width: 80px;
        height: 80px;
        object-fit: cover;
        border-radius: 3px;
        cursor: pointer;
        border: 2px solid transparent;
      }

      .thumbnail:hover {
        border-color: #3498db;
      }

      .product-info h1 {
        margin: 0 0 15px 0;
        font-size: 1.8rem;
        color: #2c3e50;
      }

      .product-description {
        margin: 20px 0;
      }

      .product-description h3 {
        font-size: 1.2rem;
        margin-bottom: 10px;
        color: #2c3e50;
      }

      .stock-info {
        margin: 20px 0;
      }

      .in-stock {
        color: #27ae60;
        font-weight: bold;
      }

      .out-of-stock {
        color: #e74c3c;
        font-weight: bold;
      }

      .add-to-cart-btn {
        background-color: #3498db;
        color: white;
        border: none;
        padding: 12px 25px;
        border-radius: 4px;
        cursor: pointer;
        font-size: 1rem;
        font-weight: bold;
        transition: background-color 0.3s;
      }

      .add-to-cart-btn:hover {
        background-color: #2980b9;
      }

      .related-products {
        margin-top: 50px;
      }

      .related-products h2 {
        font-size: 1.5rem;
        margin-bottom: 20px;
        color: #2c3e50;
      }

      .related-products-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
        gap: 20px;
      }

      .related-product-card {
        border: 1px solid #e1e1e1;
        border-radius: 5px;
        overflow: hidden;
        transition: transform 0.3s;
      }

      .related-product-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 5px 15px rgba(0,0,0,0.1);
      }

      .related-product-card .product-image {
        height: 150px;
      }

      .related-product-card h3 {
        padding: 10px;
        margin: 0;
        font-size: 0.9rem;
        color: #2c3e50;
      }

      .category-sidebar h3 {
        margin-top: 20px;
      }

      .category-sidebar ul {
        list-style: none;
        padding: 0;
      }

      .category-sidebar ul li {
        margin-bottom: 10px;
      }

      .category-sidebar ul li a {
        color: #3498db;
        text-decoration: none;
      }

      .category-sidebar ul li a:hover {
        color: #2980b9;
      }

      @media (max-width: 768px) {
        .product-container {
          grid-template-columns: 1fr;
        }

        .main-image {
          height: 300px;
        }
      }
    </style>
  </head>

  <body>
    <header>
      <div class="header-container">
        <div class="logo">
          <%= link_to "Clubhouse Collective", root_path %>
        </div>
        <nav>
          <ul>
            <li><%= link_to "Home", root_path %></li>
            <li><%= link_to "Products", products_path %></li>
            <li><%= link_to "About", "/about" %></li>
            <li><%= link_to "Contact", "/contact" %></li>
          </ul>
        </nav>
      </div>
    </header>

    <% if notice %>
      <div class="notice"><%= notice %></div>
    <% end %>
    <% if alert %>
      <div class="alert"><%= alert %></div>
    <% end %>

    <main>
      <%= yield %>
    </main>

    <footer>
      <div class="footer-container">
        <div class="footer-section">
          <h3>Clubhouse Collective</h3>
          <p>Premium golf gear and streetwear for the modern golfer.</p>
        </div>

        <nav class="footer-section">
          <h3>Quick Links</h3>
          <ul>
            <li><%= link_to "Home", root_path %></li>
            <li><%= link_to "Products", products_path %></li>
            <li><%= link_to "About", "/about" %></li>
            <li><%= link_to "Contact", "/contact" %></li>
          </ul>
        </nav>

        <div class="footer-section">
          <h3>Contact Us</h3>
          <p>Email: info@clubhousecollective.com</p>
          <p>Phone: (204) 555-1234</p>
        </div>
      </div>

      <div class="copyright">
        &copy; <%= Date.today.year %> Clubhouse Collective. All Rights Reserved.
      </div>
    </footer>

  </body>
</html>