<!DOCTYPE html>
<html>
  <head>
    <title>Clubhouse Collective</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <style>
      body {
        font-family: Arial, sans-serif;
        margin: 0;
        padding: 20px;
      }
      .notice, .alert {
        padding: 10px;
        margin-bottom: 15px;
      }
      .notice { background-color: #d4edda; }
      .alert { background-color: #f8d7da; }

      nav ul {
        list-style: none;
        padding: 0;
        display: flex;
        gap: 20px;
        margin-bottom: 30px;
      }

      nav ul li a {
        text-decoration: none;
        color: #333;
        font-weight: bold;
      }

      nav ul li a:hover {
        color: #666;
      }
    </style>

    <%# <%= javascript_importmap_tags %>
  </head>

  <body>
    <nav>
      <ul>
        <li><%= link_to "Home", root_path %></li>
        <li><%= link_to "About", "/about" %></li>
        <li><%= link_to "Contact", "/contact" %></li>
      </ul>
    </nav>

    <p class="notice"><%= notice %></p>
    <p class="alert"><%= alert %></p>

    <%= yield %>
  </body>
</html>