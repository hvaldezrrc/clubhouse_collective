<div class="container checkout-page">
  <h1>Checkout - Step 3: Confirm Order</h1>

  <div class="checkout-progress">
    <div class="step completed">Address</div>
    <div class="step completed">Payment</div>
    <div class="step active">Confirm</div>
  </div>

  <div class="checkout-form">
    <div class="address-details">
      <h2>Shipping Address</h2>
      <p><%= @address.street %></p>
      <p><%= @address.city %>, <%= @province.code %> <%= @address.postal_code %></p>
    </div>

    <div class="payment-details">
      <h2>Payment Method</h2>
      <p><%= @payment_method.humanize %></p>
    </div>
  </div>

  <div class="order-details">
    <h2>Order Items</h2>
    <table class="cart-table">
      <thead>
        <tr>
          <th>Product</th>
          <th>Price</th>
          <th>Quantity</th>
          <th>Subtotal</th>
        </tr>
      </thead>
      <tbody>
        <% @cart_items.each do |item| %>
          <tr>
            <td><h3><%= item.name %></h3></td>
            <td>$<%= sprintf("%.2f", item.price) %></td>
            <td><%= item.quantity %></td>
            <td>$<%= sprintf("%.2f", item.price * item.quantity) %></td>
          </tr>
        <% end %>

        <tr class="summary-row">
          <td colspan="3" class="text-right">Subtotal:</td>
          <td class="subtotal">$<%= sprintf("%.2f", @subtotal) %></td>
        </tr>

        <% if @gst_amount > 0 %>
          <tr>
            <td colspan="3" class="text-right">GST (<%= @gst_rate %>%):</td>
            <td class="subtotal">$<%= sprintf("%.2f", @gst_amount) %></td>
          </tr>
        <% end %>

        <% if @pst_amount > 0 %>
          <tr>
            <td colspan="3" class="text-right">PST (<%= @pst_rate %>%):</td>
            <td class="subtotal">$<%= sprintf("%.2f", @pst_amount) %></td>
          </tr>
        <% end %>

        <% if @hst_amount > 0 %>
          <tr>
            <td colspan="3" class="text-right">HST (<%= @hst_rate %>%):</td>
            <td class="subtotal">$<%= sprintf("%.2f", @hst_amount) %></td>
          </tr>
        <% end %>

        <tr class="total-row">
          <td colspan="3" class="text-right">Total:</td>
          <td class="total">$<%= sprintf("%.2f", @total) %></td>
        </tr>
      </tbody>
    </table>
  </div>

  <%= form_with url: checkout_complete_path, method: :post, local: true do |form| %>
    <%= form.hidden_field :order_id, value: @order.id %>
    <div class="form-actions">
      <%= link_to "Back to Payment", checkout_payment_path, class: "back-btn" %>
      <%= form.submit "Place Order", class: "place-order-btn" %>
    </div>
  <% end %>
</div>
