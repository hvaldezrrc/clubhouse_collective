<div class="container checkout-page">
  <h1>Checkout - Step 3: Review & Confirm</h1>

  <div class="checkout-progress">
    <div class="step completed">Address</div>
    <div class="step completed">Payment</div>
    <div class="step active">Confirm</div>
  </div>

  <div class="order-details">
    <div class="address-details">
      <h2>Shipping Address</h2>
      <p><%= @address.street %></p>
      <p><%= @address.city %>, <%= @province.code %> <%= @address.postal_code %></p>
    </div>

    <div class="order-summary">
      <h2>Order Summary</h2>
      <table class="cart-table">
        <thead>
          <tr>
            <th>Product</th>
            <th>Price</th>
            <th>Quantity</th>
            <th>Total</th>
          </tr>
        </thead>
        <tbody>
          <% @cart_items.each do |item| %>
            <tr>
              <td class="product-info">
                <% if item[:product].images.attached? %>
                  <img src="<%= rails_blob_path(item[:product].images.first, only_path: true) %>" alt="<%= item[:product].name %>" class="cart-thumbnail">
                <% end %>
                <div>
                  <h3><%= item[:product].name %></h3>
                  <p class="cart-product-category"><%= item[:product].category.name %></p>
                </div>
              </td>
              <td class="price">$<%= sprintf("%.2f", item[:product].price) %></td>
              <td class="quantity"><%= item[:quantity] %></td>
              <td class="total">$<%= sprintf("%.2f", item[:product].price * item[:quantity]) %></td>
            </tr>
          <% end %>
        </tbody>
        <tfoot>
          <tr>
            <td colspan="3" class="text-right"><strong>Subtotal:</strong></td>
            <td class="subtotal">$<%= sprintf("%.2f", @subtotal) %></td>
          </tr>
          <% if @tax_rate.gst > 0 %>
            <tr>
              <td colspan="3" class="text-right">GST (<%= (@tax_rate.gst * 100).round(2) %>%):</td>
              <td class="subtotal">$<%= sprintf("%.2f", @gst_amount) %></td>
            </tr>
          <% end %>
          <% if @tax_rate.pst > 0 %>
            <tr>
              <td colspan="3" class="text-right">PST (<%= (@tax_rate.pst * 100).round(2) %>%):</td>
              <td class="subtotal">$<%= sprintf("%.2f", @pst_amount) %></td>
            </tr>
          <% end %>
          <% if @tax_rate.hst > 0 %>
            <tr>
              <td colspan="3" class="text-right">HST (<%= (@tax_rate.hst * 100).round(2) %>%):</td>
              <td class="subtotal">$<%= sprintf("%.2f", @hst_amount) %></td>
            </tr>
          <% end %>
          <tr class="order-total">
            <td colspan="3" class="text-right"><strong>Total:</strong></td>
            <td class="total-amount">$<%= sprintf("%.2f", @total_amount) %></td>
          </tr>
        </tfoot>
      </table>
    </div>

    <div class="payment-details">
      <h2>Payment</h2>
      <p>This is a demo store. No actual payment will be processed.</p>
    </div>
  </div>

  <%= form_with(url: checkout_complete_path, method: :post, class: "confirm-form") do |f| %>
    <div class="form-actions">
      <%= link_to "Back to Payment", checkout_payment_path, class: "back-btn" %>
      <%= f.submit "Place Order", class: "place-order-btn" %>
    </div>
  <% end %>
</div>