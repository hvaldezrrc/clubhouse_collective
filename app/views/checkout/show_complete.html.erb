<div class="container checkout-page order-complete">
  <div class="success-message">
    <div class="success-icon">
      <i class="fas fa-check-circle"></i>
    </div>
    <h1>Thank You for Your Order!</h1>
    <p class="success-subtitle">Your order has been placed successfully.</p>
  </div>

  <div class="order-confirmation">
    <h2>Order Details</h2>
    <div class="confirmation-info">
      <p><strong>Order Number:</strong> #<%= @order.id %></p>
      <p><strong>Date:</strong> <%= @order.created_at.strftime("%B %d, %Y at %I:%M %p") %></p>
      <p><strong>Payment Method:</strong> <%= @order.payment_method.humanize %></p>
      <p><strong>Order Status:</strong> <span class="status <%= @order.status %>"><%= @order.status.capitalize %></span></p>
    </div>
  </div>

  <div class="shipping-details">
    <h2>Shipping Information</h2>
    <p><%= @order.shipping_address %></p>
  </div>

  <div class="order-summary">
    <h2>Order Summary</h2>
    <table class="order-items-table">
      <thead>
        <tr>
          <th>Product</th>
          <th>Price</th>
          <th>Quantity</th>
          <th>Total</th>
        </tr>
      </thead>
      <tbody>
        <% @order.order_items.each do |item| %>
          <tr>
            <td><%= item.product.name %></td>
            <td>$<%= sprintf("%.2f", item.price) %></td>
            <td><%= item.quantity %></td>
            <td>$<%= sprintf("%.2f", item.price * item.quantity) %></td>
          </tr>
        <% end %>
        <tr class="summary-row">
          <td colspan="3">Subtotal:</td>
          <td>$<%= sprintf("%.2f", @order.subtotal) %></td>
        </tr>
        <% if @order.tax_amount && @order.tax_amount > 0 %>
          <tr>
            <td colspan="3">Tax:</td>
            <td>$<%= sprintf("%.2f", @order.tax_amount) %></td>
          </tr>
        <% end %>
        <tr class="total-row">
          <td colspan="3">Total:</td>
          <td class="total-amount">$<%= sprintf("%.2f", @order.total_amount) %></td>
        </tr>
      </tbody>
    </table>
  </div>

  <div class="next-steps">
    <h2>What's Next?</h2>
    <p>We'll email you an order confirmation with details and tracking info.</p>
  </div>

  <div class="order-actions">
    <%= link_to "Continue Shopping", root_path, class: "shop-btn" %>
    <%= link_to "View My Orders", dashboard_orders_path, class: "orders-btn" %>
  </div>
</div>
