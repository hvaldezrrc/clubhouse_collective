<div class="container">
  <div class="hero-section">
    <h1>Welcome to Clubhouse Collective</h1>
    <p>Premium Golf Gear & Streetwear for the Modern Golfer</p>
  </div>

  <div class="content-wrapper">
    <div class="category-sidebar">
      <h3>Categories</h3>
      <ul>
        <li>
          <%= link_to "All Products", products_path, class: params[:category_id].blank? ? 'active' : '' %>
        </li>
        <% @categories.each do |category| %>
          <li>
            <%= link_to category.name, products_path(category_id: category.id),
                class: params[:category_id].to_s == category.id.to_s ? 'active' : '',
                title: category.description %>
            <span class="product-count">(<%= category.products.count %>)</span>
          </li>
        <% end %>
      </ul>

      <h3>Filters</h3>
      <ul>
        <li><%= link_to "On Sale", products_path(on_sale: "true", category_id: params[:category_id], search: params[:search]) %></li>
        <li><%= link_to "New Products", products_path(new: "true", category_id: params[:category_id], search: params[:search]) %></li>
        <li><%= link_to "Recently Updated", products_path(recently_updated: "true", category_id: params[:category_id], search: params[:search]) %></li>
        <li><%= link_to "Clear Filters", products_path(category_id: params[:category_id], search: params[:search]) %></li>
      </ul>
    </div>

    <div class="products-section">
      <%= form_tag(products_path, method: :get, class: "search-form") do %>
        <div class="search-input">
          <%= text_field_tag :search, params[:search], placeholder: "Search by product name or description", class: "search-field" %>
        </div>
        <div class="category-select">
          <%= select_tag :category_id, options_for_select([['All Categories', nil]] + @categories.map { |category| [category.name, category.id] }, selected: params[:category_id]), prompt: "Select Category" %>
        </div>
        <%= submit_tag "Search", class: "search-btn" %>
      <% end %>

      <% if @current_category %>
        <div class="category-header">
          <h2><%= @current_category.name %></h2>
          <p><%= @current_category.description %></p>
        </div>
      <% else %>
        <div class="category-header">
          <h2>All Products</h2>
          <p>Explore our complete collection of premium golf gear and streetwear.</p>
        </div>
      <% end %>

      <div class="products-grid">
      <% if @products.any? %>
        <% @products.each do |product| %>
          <div class="product-card">
            <%= link_to product_path(product) do %>
              <div class="product-image">
                <% if product.images.attached? %>
                  <img src="<%= rails_blob_path(product.images.first, only_path: true) %>" alt="<%= product.name %>">
                <% else %>
                  <div class="no-image">No Image</div>
                <% end %>
              </div>
              <div class="product-info">
                <h3><%= product.name %></h3>
                <p class="category"><%= product.category.name %></p>
                <p class="sku">SKU: <%= product.sku %></p>
                <div class="product-footer">
                  <p class="stock"><%= product.stock_quantity > 0 ? 'In Stock' : 'Out of Stock' %></p>
                  <button class="view-btn">View Details</button>
                </div>
              </div>
            <% end %>

            <% if product.stock_quantity > 0 %>
              <div class="quick-add">
                <%= button_to "Add to Cart", cart_add_path(product.id), method: :post, class: "quick-add-btn" %>
              </div>
            <% else %>
              <div class="quick-add">
                <button class="out-of-stock-btn" disabled>Out of Stock</button>
              </div>
            <% end %>
          </div>
        <% end %>
      <% else %>
        <div class="no-products">
          <p>No products found based on your filters.</p>
        </div>
      <% end %>
    </div>

    <div class="pagination">
      <%= paginate @products %>
    </div>

    </div>
  </div>
</div>
