<div class="category-header">
  <h2>Welcome to Clubhouse Collective</h2>
  <p>Premium golf gear and streetwear for the modern golfer.</p>
</div>

<div class="category-browse-section">
  <h2>Featured Products</h2>
  <div class="category-cards">
    <% @featured_products.each do |product| %>
      <div class="category-card">
        <h3><%= link_to product.name, product_path(product) %></h3>
        <p><%= truncate(product.description, length: 100) %></p>
      </div>
    <% end %>
  </div>
</div>
